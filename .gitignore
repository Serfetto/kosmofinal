.venv/
__pycache__/
*.pyc
node_modules/
.env
.pytest_cache/

# Из data/ в репозиторий попадает то, что нужно для запуска сервиса и проверки результатов:
# готовые гексы/зоны/ряды, маски воды, метаданные сцен, кэш течений, полевой реестр,
# реестр пар (с кэшем STAC), разбиения, веса моделей, предсказания и метрики. Снимки и MARIDA — нет.
artifacts
data/*
!data/web/
!data/field/
!data/registry/
!data/splits/
!data/eval/
!data/queries/
!data/models/
data/models/*
!data/models/metrics.json
!data/models/xgb.joblib
!data/models/conc_*.json
!data/models/fusion_*.json
!data/models/MANIFEST.json
!data/processed/
data/processed/*/*
!data/processed/*/water.tif
!data/processed/*/*/
data/processed/*/*/*
!data/processed/*/*/meta.json
!data/processed/*/*/met.npz

frontend/node_modules/
frontend/dist/
frontend/.vite/

# Слой классов модели model_classes_<sha>.png лежит в репозитории готовым (python -m pipeline.class_layer):
# без det.tif его построение — повторное скачивание сцены и прогон модели. Здесь — только недописанные файлы.
data/web/*/*/.model_classes_*.tmp.png

.DS_Store
*.log
